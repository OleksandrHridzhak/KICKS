generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String
  price       Decimal
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String
}
