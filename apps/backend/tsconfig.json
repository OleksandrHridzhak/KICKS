{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "include": ["src", "./vitest.config.ts", "tests"],
  "exclude": ["node_modules", "dist", "build"]
}
