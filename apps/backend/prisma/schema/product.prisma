enum ProductGender {
  MEN
  WOMEN
  UNISEX
}

// ==============================
// Products
// ==============================

model Product {
  id           String        @id @default(uuid())
  name         String
  description  String
  price        Decimal
  targetGender ProductGender @default(UNISEX)

  categories Category[]

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())

  variants ProductVariant[]
}

model Brand {
  id   String @id @default(uuid())
  name String @unique

  products Product[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  products Product[]

  createdAt DateTime @default(now())
}

// ==============================
// Variants
// ==============================

model ProductVariant {
  id          String @id @default(uuid())
  productId   String
  variantName String
  color       String

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizes   VariantSize[]
  photos  VariantPhoto[]

  createdAt DateTime @default(now())
}

model VariantSize {
  id               String  @id @default(uuid())
  productVariantId String
  size             Decimal
  inStock          Int     @default(0)

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
}

model VariantPhoto {
  id               String @id @default(uuid())
  productVariantId String
  photoUrl         String

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
}
